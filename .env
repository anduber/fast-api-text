# Final environment configuration for Task Manager API
# Adjust values as needed for your local or deployment environment.

# Human-friendly app name shown in API docs
APP_NAME="Task Manager API"

# Semantic version of the API (shown in docs)
VERSION=1.0.0

# Environment name: development | production | staging | test
ENVIRONMENT=development

# Enable extra logging and detailed errors in development
# Do NOT enable in production
DEBUG=true

# Comma-separated list of allowed origins for CORS.
# In development you can use *, but in production set explicit domains.
# Example: https://example.com,https://admin.example.com
ALLOWED_ORIGINS=*
