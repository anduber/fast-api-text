# Example environment variables for Task Manager API
# Copy this file to `.env` and adjust values for your environment.

# Human-friendly app name shown in docs
APP_NAME="Task Manager API"

# Environment name: development | production | staging | test
ENVIRONMENT=development

# Debug mode enables extra logging and detailed errors (do not enable in production)
DEBUG=false

# Comma-separated list of allowed origins for CORS.
# In development you can use *, but in production set explicit domains.
# Example: https://example.com,https://admin.example.com
ALLOWED_ORIGINS=*