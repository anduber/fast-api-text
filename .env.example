# Example environment variables for Task Manager API
# Copy this file to `.env` and adjust values for your environment.

# Human-friendly app name shown in docs
APP_NAME="Task Manager API"

# Environment name: development | production | staging | test
ENVIRONMENT=development

# Debug mode enables extra logging and detailed errors (do not enable in production)
DEBUG=false

# Comma-separated list of allowed origins for CORS.
# In development you can use *, but in production set explicit domains.
# Example: https://example.com,https://admin.example.com
ALLOWED_ORIGINS=*

# Database connection string used by SQLAlchemy
# Default: SQL Server (username/password)
DATABASE_URL="mssql+pyodbc://username:password@localhost:1433/task_manager?driver=ODBC+Driver+17+for+SQL+Server&Encrypt=yes&TrustServerCertificate=yes"

# Alternative: SQL Server (Windows Integrated Authentication)
# DATABASE_URL="mssql+pyodbc://@localhost:1433/task_manager?driver=ODBC+Driver+17+for+SQL+Server&trusted_connection=yes&Encrypt=yes&TrustServerCertificate=yes"

# Alternative: SQLite (development)
# DATABASE_URL="sqlite:///./task_manager.db"
